# hosted is a real-provider profile; mock is only wiring verification.
PROVIDER_MODE=hosted
STT_PROVIDER=deepgram
# Leave URL/model blank to use defaults for the selected recognition provider.
STT_URL=""
STT_MODEL=""
STT_API_KEY=""
# Configure a model supported by each endpoint. Keys may be empty on local endpoints.
DIALOGUE_BASE_URL=https://api.openai.com/v1
DIALOGUE_MODEL=gpt-4.1-mini
DIALOGUE_API_KEY=""
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4.1-mini
VISION_API_KEY=""
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_API_KEY=""
# Stable voice used for the first attendee.
TTS_VOICE=coral
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Sensitive troubleshooting option: transcript text in server logs. Off by default.
LOG_TRANSCRIPTS=false

# Optional observation-only evaluator. Sends conversation excerpts to TypeSafe.
JEV_SHADOW=false
JEV_API_KEY=""
JEV_MODEL=jev-1.13.0

# Separate shared passwords, at least 12 characters each. Keep real values outside Git.
MEETING_PASSWORD=""
ADMIN_PASSWORD=""
# false only for loopback HTTP. Set true behind external HTTPS.
COOKIE_SECURE=false
DATA_PATH=data/control.sqlite3
MEETING_BUDGET_USD=1.50
DAILY_BUDGET_USD=10.00
MAX_CONCURRENT_MEETINGS=3
MAX_ATTENDEES=4
MAX_MEETING_MINUTES=30
IDLE_TIMEOUT_MINUTES=5
TTS_VOICES=coral,ash,sage,echo
# Required for other endpoint/model profiles. Explicit rates may be zero for local models.
# JSON keys: input_million, output_million, vision_call, tts_character, stt_minute, judge_call
COST_RATES_JSON=""

# Trust forwarded headers only from your known reverse proxy addresses/CIDRs.
FORWARDED_ALLOW_IPS=127.0.0.1

# Dedicated scrape credential. /metrics returns 503 until configured.
METRICS_TOKEN=""
# Approved provider connections, with key_env references instead of inline secrets.
PROVIDER_CONNECTIONS_JSON=""
